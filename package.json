{
  "name": "sp-keshavarz",
  "displayName": "sp-keshavarz",
  "description": "Vscode extension for work",
  "publisher": "Noctyra",
  "version": "0.7.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noctyra/sp-keshavarz.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "sp-keshavarz.runScriptPicker",
        "title": "My Workflow"
      },
      {
        "command": "sp-keshavarz.generate",
        "title": "My Workflow: Generate from Recipe"
      },
      {
        "command": "sp-keshavarz.duplicate",
        "title": "Duplicate As..."
      },
      {
        "command": "sp-keshavarz.typeFromJson",
        "title": "My Workflow: Type from JSON"
      }
    ],
    "keybindings": [
      {
        "command": "sp-keshavarz.runScriptPicker",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "!terminalFocus"
      },
      {
        "command": "sp-keshavarz.typeFromJson",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sp-keshavarz.runScriptPicker",
          "when": "explorerResourceIsFolder",
          "group": "2_modification"
        },
        {
          "command": "sp-keshavarz.duplicate",
          "when": "explorerResourceIsFolder",
          "group": "2_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "sp-keshavarz.generate",
          "when": "false"
        }
      ]
    },
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/react-snippets.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/react-snippets.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/react-snippets.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/react-snippets.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.54.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  },
  "packageManager": "pnpm@9.0.0+sha512.b4106707c7225b1748b61595953ccbebff97b54ad05d002aa3635f633b9c53cd666f7ce9b8bc44704f1fa048b9a49b55371ab2d9e9d667d1efe2ef1514bcd513"
}
